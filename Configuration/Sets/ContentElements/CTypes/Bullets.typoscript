tt_content.bullets =< lib.contentElement
tt_content.bullets {
  templateName = Bullets
  dataProcessing {
    10 = TYPO3\CMS\Frontend\DataProcessing\SplitProcessor
    10 {
      fieldName = bodytext
      as = bullets
      removeEmptyEntries = 1
    }
  }
  settings {
    sitekit {
      contentElements {
        bullets {
          listIconIdentifier = {$sitekit.contentElements.bullets.listIconIdentifier}
        }
      }
    }
  }
}