page = PAGE
page {
  config {
    sendCacheHeaders = 1
    cache_period = 86400
  }

  bodyTagCObject = COA
  bodyTagCObject {
    10 = TEXT
    10.value = <body

    20 = TEXT
    20.stdWrap {
      data = page:uid
      noTrimWrap = | id="page-|"|
    }

    30 = TEXT
    30 {
      stdWrap {
        data = siteLanguage:locale.languageCode
        noTrimWrap = | class="lang-|"|
      }
    }

    100 = TEXT
    100.value = >
  }


  10 = PAGEVIEW
  10 {
    paths {
      60 = EXT:ot_sitekitbase/Resources/Private/Templates/{$sitekit.frameworks.frontend.directory}/
      61 = EXT:ot_sitekitbase/Resources/Private/Components/{$sitekit.frameworks.frontend.directory}/
      # 70 = EXT:ot_sitekitbasetheme123/Resources/Private/Templates/…
      # 80 = EXT:my_sitepackage/Resources/Private/Templates/…
    }

    dataProcessing {

      100 = page-content
      100 {
        as = content
      }

      200 = menu
      200 {
        special = directory
        special.value = {$sitekit.pages.root}
        levels = 2
        as = mainMenu
      }

      210 = menu
      210 {
        special = directory
        special.value = {$sitekit.pages.topMenuRootPage}
        levels = 1
        as = topMenu
      }

      300 = menu
      300 {
        special = rootline
        as = breadcrumb
      }

      400 = language-menu
      400 {
        as = languageMenu
      }

    }
  }
}

# If the root page for the footer navigation is set, the data processor is activated
[traverse(site('configuration'), 'settings/sitekit/pages/footerNavigationRootPage') > 0]
  page.10.dataProcessing {
    1749220162 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
    1749220162 {
      special = directory
      special.value = {$sitekit.pages.footerNavigationRootPage}
      levels = 1
      as = footerNavigation
    }
  }
[GLOBAL]
