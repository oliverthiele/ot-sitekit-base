{
	"name": "oliverthiele/ot-sitekit-base",
	"type": "typo3-cms-extension",
	"description": "SiteKit Base - Foundation of the SiteKit system: Bootstrap 5 page templates, content element and container layouts, backend layouts and shared site settings.",
	"homepage": "https://www.oliver-thiele.de/",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Oliver Thiele",
			"email": "mail@oliver-thiele.de",
			"role": "Developer",
			"homepage": "https://www.oliver-thiele.de/"
		}
	],
	"require": {
		"php": ">=8.4",
		"typo3/cms-core": "^14.3",
		"oliverthiele/ot-icons": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"OliverThiele\\OtSitekitbase\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "ot_sitekitbase"
		}
	}
}
