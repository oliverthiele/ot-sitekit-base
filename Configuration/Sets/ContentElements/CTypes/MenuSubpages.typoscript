# Menu of subpages of selected pages additional menuImage(s)
# (Only one menu image is allowed)
# CType: menu_subpages

tt_content.menu_subpages =< lib.contentElement
tt_content.menu_subpages {
    templateName = MenuSubpages
    dataProcessing {
        10 = menu
        10 {
            special = directory
            special.value.field = pages
            dataProcessing {
                10 = files
                10 {
                    references.fieldName = menu_image
                    as = menuImages
                }
            }
        }
    }
}
