page = PAGE
page {
  config {
    sendCacheHeaders = 1
    cache_period = 86400
  }

  bodyTagCObject = COA
  bodyTagCObject {
    10 = TEXT
    10.value = <body

    20 = TEXT
    20.stdWrap {
      data = page:uid
      noTrimWrap = | id="page-|"|
    }

    30 = TEXT
    30 {
      stdWrap {
        data = siteLanguage:locale.languageCode
        noTrimWrap = | class="lang-|"|
      }
    }

    100 = TEXT
    100.value = >
  }


  10 = PAGEVIEW
  10 {
    paths {
      # Base extension, with standard Bootstrap 5 layouts
      60 = EXT:ot_sitekitbase/Resources/Private/PageView/{$sitekit.frameworks.frontend.directory}/

      # Preset = Directories with partials, SCSS, JS
      61 = EXT:ot_sitekitbase/Resources/Private/Presets/{$sitekit.frameworks.frontend.directory}/

      # Themes use "70"
      # 70 = EXT:ot_sitekitbasetheme/Resources/Private/Templates/…

      # The final sitepackage use "80"
      # 80 = EXT:my_sitepackage/Resources/Private/Templates/…
    }

    dataProcessing {

      100 = page-content
      100 {
        as = content
      }

      200 = menu
      200 {
        special = directory
        special.value = {$sitekit.menus.main.rootPage}
        levels = {$sitekit.menus.main.levels}
        as = menuMain
      }

      300 = menu
      300 {
        special = rootline
        as = menuBreadcrumb
      }

    }
  }
}

# If the root page for the top navigation is set, the data processor is activated
[traverse(site('configuration'), 'settings/sitekit/menus/top/rootPage') > 0]
  page.10.dataProcessing {
    1768425232 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
    1768425232 {
      special = directory
      special.value = {$sitekit.menus.top.rootPage}
      levels = 1
      as = menuTop
    }
  }
[GLOBAL]

# If the root page for the footer navigation is set, the data processor is activated
[traverse(site('configuration'), 'settings/sitekit/menus/footer/rootPage') > 0]
  page.10.dataProcessing {
    1749220162 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
    1749220162 {
      special = directory
      special.value = {$sitekit.menus.footer.rootPage}
      levels = 1
      as = menuFooter
    }
  }
[GLOBAL]

# sitekit.menus.language.enabled
[traverse(site('configuration'), 'settings/sitekit/menus/language/enabled') == 1]
  page.10.dataProcessing {
    400 = language-menu
    400 {
      as = menuLanguage
    }
  }
[end]
